{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": "dist-delivery",
    "rootDir": ".",
    "plugins": []
  },
  "include": [
    "scripts/delivery-cli.ts",
    "lib/telegram/delivery/**/*.ts",
    "lib/telegram/report-plan.ts",
    "lib/telegram/bot-api.ts",
    "lib/telegram/config.ts",
    "scripts/inbox-cli.ts",
    "lib/telegram/inbox/**/*.ts",
    "scripts/business-backfill-cli.ts",
    "scripts/key-rotation-cli.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-delivery"
  ]
}
